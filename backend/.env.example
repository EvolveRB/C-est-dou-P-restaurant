# Base de datos operacional (MongoDB Atlas) - reemplazar con credenciales propias
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/restaurante_db?retryWrites=true&w=majority

# Base de datos relacional local (SQLite por defecto)
SQLITE_URL=

# Seguridad de sesiones (opcional: si se omite, se genera y persiste en SQLite)
AUTH_SECRET_KEY=cambia-esta-clave-secreta-de-al-menos-32-caracteres
ADMIN_SETUP_CODE=

# Almacenamiento de imágenes en Azure Blob Storage (ej: https://<cuenta>.blob.core.windows.net/platos)
AZURE_BLOB_BASE_URL=

# Envío de comprobantes por correo (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cestdouxp.cl
SMTP_USE_TLS=true
