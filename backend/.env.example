# MongoDB Atlas (obligatorio en desarrollo y producción)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/restaurante_db?retryWrites=true&w=majority

# SQLite local o Turso (opcional; por defecto usa backend/restaurant.db)
# SQLITE_URL=sqlite:///./restaurant.db

# Seguridad de sesiones y activación inicial
AUTH_SECRET_KEY=<clave_aleatoria_larga_min_32_caracteres>
# ADMIN_SETUP_CODE=<codigo_opcional_para_activar_primer_admin>

# Almacenamiento de imágenes (AWS S3 + CloudFront)
CLOUDFRONT_BASE_URL=https://d29jcylbmgo4bc.cloudfront.net
AWS_S3_BUCKET=carta-img
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=<tu_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<tu_aws_secret_access_key>

# Envío de comprobantes electrónicos por correo (Resend API HTTPS recomendado en Railway, o SMTP)
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=C'est doux P <onboarding@resend.dev>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<tu_correo@dominio.com>
SMTP_PASSWORD=<tu_app_password>
SMTP_FROM=C'est doux P <no-reply@cestdouxp.cl>
